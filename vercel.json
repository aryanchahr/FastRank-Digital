{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ranksfuel.com"
        }
      ],
      "destination": "https://ranksfuel.com/$1",
      "permanent": true
    },
    {
      "source": "/locations/united-kingdom",
      "destination": "/locations/uk-seo-agency",
      "permanent": true
    },
    {
      "source": "/locations/united-kingdom.html",
      "destination": "/locations/uk-seo-agency",
      "permanent": true
    },
    {
      "source": "/locations/new-zealand",
      "destination": "/locations/new-zealand-seo",
      "permanent": true
    },
    {
      "source": "/locations/new-zealand.html",
      "destination": "/locations/new-zealand-seo",
      "permanent": true
    },
    {
      "source": "/locations/united-states",
      "destination": "/locations/usa-seo-agency",
      "permanent": true
    },
    {
      "source": "/locations/united-states.html",
      "destination": "/locations/usa-seo-agency",
      "permanent": true
    },
    {
      "source": "/locations/india",
      "destination": "/locations/india-seo-agency",
      "permanent": true
    },
    {
      "source": "/locations/india.html",
      "destination": "/locations/india-seo-agency",
      "permanent": true
    },
    {
      "source": "/services/google-ads",
      "destination": "/services/google-ads-management",
      "permanent": true
    },
    {
      "source": "/services/google-ads.html",
      "destination": "/services/google-ads-management",
      "permanent": true
    }
  ]
}
